# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_SECRET=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Ingestion Pipeline Secrets
# Generate strong random strings (16+ characters)
INGESTION_SECRET=your-ingestion-secret-here
# CRON_SECRET must also exist in the Vercel project env — Vercel only sends the
# "Authorization: Bearer <CRON_SECRET>" header when the variable is set there.
CRON_SECRET=your-cron-secret-here

# Channel Sync (comma-separated YouTube channel IDs)
# Polled daily by /api/cron/sync-channels. Defaults to the Festo Service
# channel (UCswhE6URzxILULeMYqOC1Cg) when unset.
MONITORED_CHANNEL_IDS=UCswhE6URzxILULeMYqOC1Cg
# Videos ingested per channel per cron run (default 4). Lower this if the
# function hits its time limit; leftovers are picked up by the next run.
# SYNC_MAX_VIDEOS_PER_RUN=4

# Auth (Login Gate)
AUTH_USERNAME=team
AUTH_PASSWORD=your-password-here
AUTH_SECRET=your-64-hex-chars-here   # Generate via: openssl rand -hex 32

# Admin Area (separate gate for /admin/* — feedback review & search gaps)
# Distinct credentials; reuses AUTH_SECRET for signing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here

# Channel Classification Overrides (optional)
# Comma-separated lists, case-insensitive, substring matching
# Blocklist takes precedence over allowlist (security first)
# CHANNEL_ALLOWLIST=partner corp,automation training
# CHANNEL_BLOCKLIST=parody,fake,test channel
