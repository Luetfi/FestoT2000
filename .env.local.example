# PostgreSQL with pgvector (local: Docker container, see README; AWS: Amazon RDS)
# Do not put sslmode into the URL - TLS is configured by the two variables below.
DATABASE_URL=postgresql://festo:your-password@127.0.0.1:55433/festo_video_search
# TLS to the database (both optional, leave unset for the local container):
#   DATABASE_SSL_CA  path to a CA bundle -> encrypted + certificate verified.
#                    The Docker image ships the RDS bundle at the path below.
#   DATABASE_SSL     'require' -> encrypted without certificate verification
# DATABASE_SSL_CA=/app/certs/rds-global-bundle.pem
# DATABASE_SSL=require

# Amazon Bedrock. On EC2 the instance role provides access, no key needed.
# Locally the usual AWS credentials apply (e.g. AWS_PROFILE). All optional:
# BEDROCK_REGION=eu-central-1
# BEDROCK_CHAT_MODEL_ID=eu.amazon.nova-2-lite-v1:0
# BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# YouTube Data API (optional, only needed to ingest new videos)
YOUTUBE_API_KEY=your-youtube-api-key

# Ingestion Pipeline Secrets
# Generate strong random strings (16+ characters)
INGESTION_SECRET=your-ingestion-secret-here
# Sent by the scheduler as "Authorization: Bearer <CRON_SECRET>" when it calls
# /api/cron/sync-channels.
CRON_SECRET=your-cron-secret-here

# Channel Sync (comma-separated YouTube channel IDs)
# Polled daily by /api/cron/sync-channels. Defaults to the Festo Service
# channel (UCswhE6URzxILULeMYqOC1Cg) when unset.
MONITORED_CHANNEL_IDS=UCswhE6URzxILULeMYqOC1Cg
# Videos ingested per channel per cron run (default 4). Lower this if the
# function hits its time limit; leftovers are picked up by the next run.
# SYNC_MAX_VIDEOS_PER_RUN=4

# Auth (Login Gate)
AUTH_USERNAME=team
AUTH_PASSWORD=your-password-here
# Generate via: openssl rand -hex 32 (no comment on the value line - Docker's
# --env-file would take it as part of the value)
AUTH_SECRET=your-64-hex-chars-here

# Admin Area (separate gate for /admin/* — feedback review & search gaps)
# Distinct credentials; reuses AUTH_SECRET for signing.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here

# Channel Classification Overrides (optional)
# Comma-separated lists, case-insensitive, substring matching
# Blocklist takes precedence over allowlist (security first)
# CHANNEL_ALLOWLIST=partner corp,automation training
# CHANNEL_BLOCKLIST=parody,fake,test channel
