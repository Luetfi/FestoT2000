# env files (can opt-in for committing if needed)
.env*.local
.env.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI temp files
supabase/.temp/

.vercel

# editor settings
.vscode/

# documents
*.docx

# lokale Wegwerf-Skripte, Logs und Screenshots
scripts/.*.mjs
scripts/*.bak
scripts/**/*.log
/image*.png
